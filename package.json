{
  "name": "incometax",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"wrangler dev\"",
    "geocode:complexes": "node --env-file-if-exists=.dev.vars scripts/geocode.ts",
    "ingest:complexes": "node --env-file-if-exists=.dev.vars scripts/ingest-complexes.ts",
    "verify:complex-api": "node --env-file-if-exists=.dev.vars scripts/verify-complex-api.ts",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "vitest run --exclude 'tests/**/*.workerd.test.ts'",
    "test:workers": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
